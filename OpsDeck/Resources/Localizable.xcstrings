          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the oh-my-zsh framework (themes/plugins) for zsh. Uses the official GitHub source by default and falls back to the Gitee mirror on failure. For servers in mainland China, enable “China network acceleration” in Settings. Does not change the default shell."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為 zsh 安裝 oh-my-zsh 框架（主題/外掛）。預設走 GitHub 官方源，失敗自動回退 Gitee 鏡像。境內伺服器可在設定裡開啟「境內網路加速」。不改預設 shell。"
          }
        }
      }
    },
